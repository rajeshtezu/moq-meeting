[Unit]
Description=MoQ auth server (verifies relay JWTs)
After=network-online.target

[Service]
User=moq
ExecStart=/usr/bin/moq auth serve --key /etc/moq/keys/public.jwk --listen 127.0.0.1:4440
Restart=always
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
