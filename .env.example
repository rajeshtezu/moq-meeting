# Bun app server. Defaults (shown) target local dev; see apps/server/src/config.ts.
PORT=3000
# Public relay base URL the browser dials.
RELAY_URL=https://localhost:4443
# Dev only: the relay's self-signed fingerprint. Unset in production.
RELAY_FINGERPRINT_URL=http://localhost:4443/certificate.sha256
MOQ_PRIVATE_KEY_FILE=infra/keys/private.jwk
TOKEN_TTL_SECONDS=14400
